[Unit]
Description=RGS DB API
After=network.target mysql.service

[Service]
User=rgsapi
WorkingDirectory=/opt/rgs-interface
EnvironmentFile=/opt/rgs-interface/.env
ExecStart=/opt/rgs-interface/.venv/bin/uvicorn rgs_interface.server:app --host 127.0.0.1 --port ${PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
