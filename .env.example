# --- server (rgs_interface.server) ---
API_DOMAIN=api.rgs.example.com          # Caddy gets a Let's Encrypt cert for this name
DB_HOST=127.0.0.1
DB_USER=api_user
DB_PASS=
DB_NAME=global_prod
# token:consumer:scope  — scope r (read) or rw (read+write); one per consumer
API_TOKENS=change-me-1:supervisor:r,change-me-2:alert:r,change-me-3:aicdss:rw
API_VALIDATE=1

# --- clients (rgs-cli / HttpBackend) ---
# RGS_API_URL=https://api.rgs.example
# RGS_API_TOKEN=change-me-1
